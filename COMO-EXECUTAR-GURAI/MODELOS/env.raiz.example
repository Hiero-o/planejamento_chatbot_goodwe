from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
FRONTEND = ROOT / "frontend"
VENV_PYTHON = ROOT / ".venv" / "Scripts" / "python.exe"
OLLAMA_URL = "http://127.0.0.1:11434"
OLLAMA_MODEL = "nomic-embed-text"


def line() -> None:
    print("-" * 72)


def read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        entry = raw.strip()
        if not entry or entry.startswith("#") or "=" not in entry:
            continue
        key, value = entry.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def python_for_project() -> str:
    return str(VENV_PYTHON) if VENV_PYTHON.exists() else sys.executable


def run(args: list[str], *, cwd: Path, description: str) -> bool:
    print(f"\n{description}")
    print("Comando:", subprocess.list2cmdline(args))
    result = subprocess.run(args, cwd=str(cwd), check=False)
    if result.returncode != 0:
        print(f"[ERRO] O comando terminou com código {result.returncode}.")
        return False
    return True


def make_env_files() -> None:
    root_env = ROOT / ".env"
    front_env = FRONTEND / ".env.local"
    root_template = HERE / "modelos" / "env.raiz.example"
    front_template = HERE / "modelos" / "env.frontend.example"

    for target, template in ((root_env, root_template), (front_env, front_template)):
        if target.exists():
            print(f"[MANTIDO] {target.relative_to(ROOT)} já existe; não será sobrescrito.")
            continue
        if not template.exists():
            print(f"[ERRO] Modelo de configuração não encontrado: {template}")
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(template, target)
        print(f"[CRIADO] {target.relative_to(ROOT)} a partir do modelo de exemplo.")

    print("\nEdite .env e frontend/.env.local com as credenciais reais antes de iniciar.")
    print("Os modelos criados contêm apenas valores ilustrativos, não credenciais válidas.")


def check_tools() -> bool:
    okay = True
    checks = [
        ("Python", [sys.executable, "--version"], ROOT),
        ("npm", ["npm", "--version"], FRONTEND),
        ("Ollama CLI", ["ollama", "--version"], ROOT),
    ]
    for label, command, cwd in checks:
        try:
            result = subprocess.run(command, cwd=str(cwd), capture_output=True, text=True, check=False)
            if result.returncode == 0:
                print(f"[OK] {label}: {(result.stdout or result.stderr).strip().splitlines()[0]}")
            else:
                print(f"[FALTA] {label}: comando falhou.")
                okay = False
        except FileNotFoundError:
            print(f"[FALTA] {label}: não encontrado no PATH.")
            okay = False
    for path in (ROOT / "requirements.txt", ROOT / "indexar_base.py", FRONTEND / "package.json", FRONTEND / "package-lock.json"):
        status = "OK" if path.exists() else "FALTA"
        print(f"[{status}] {path.relative_to(ROOT)}")
        okay = okay and path.exists()
    return okay


def setup() -> None:
    line()
    print("PREPARAÇÃO DO AMBIENTE GURAI")
    line()
    if not check_tools():
        print("\nInstale os requisitos ausentes e execute a preparação novamente.")
        return

    make_env_files()

    if not VENV_PYTHON.exists():
        if not run([sys.executable, "-m", "venv", str(ROOT / ".venv")], cwd=ROOT, description="Criando ambiente virtual Python"):
            return
    py = str(VENV_PYTHON)
    if not run([py, "-m", "pip", "install", "--upgrade", "pip"], cwd=ROOT, description="Atualizando pip"):
        return
    if not run([py, "-m", "pip", "install", "-r", "requirements.txt"], cwd=ROOT, description="Instalando dependências Python"):
        return
    if not run(["npm", "ci"], cwd=FRONTEND, description="Instalando dependências do frontend com package-lock.json"):
        return

    print("\n[OK] Dependências instaladas.")
    if not ollama_healthy():
        print("O Ollama ainda não respondeu; ele será verificado ao iniciar o projeto.")
    elif not model_installed():
        answer = input(f"O modelo {OLLAMA_MODEL} não está instalado. Baixar agora? [s/N]: ").strip().lower()
        if answer == "s":
            run(["ollama", "pull", OLLAMA_MODEL], cwd=ROOT, description=f"Baixando {OLLAMA_MODEL}")
    print("\nPróximo passo: preencha as variáveis de ambiente e escolha 'Iniciar todos os serviços'.")


def ollama_healthy() -> bool:
    try:
        with urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=3) as response:
            return response.status == 200
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def start_ollama() -> bool:
    if ollama_healthy():
        print("[OK] Ollama já está respondendo em", OLLAMA_URL)
        return True
    ollama = shutil.which("ollama")
    if not ollama:
        print("[ERRO] Ollama não encontrado. Instale o Ollama para Windows primeiro.")
        return False
    print("Ollama não respondeu. Abrindo 'ollama serve' em uma nova janela...")
    command = f'"{ollama}" serve'
    try:
        subprocess.Popen(
            ["cmd.exe", "/c", "start", "Ollama local", "cmd.exe", "/k", command],
            cwd=str(ROOT),
        )
    except OSError as exc:
        print(f"[ERRO] Não foi possível iniciar o Ollama: {exc}")
        return False
    for _ in range(30):
        if ollama_healthy():
            print("[OK] Ollama inicializado.")
            return True
        time.sleep(1)
    print("[ERRO] Ollama não respondeu após 30 segundos. Confira a janela aberta.")
    return False


def model_installed() -> bool:
    try:
        with urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=5) as response:
            data = json.loads(response.read().decode("utf-8"))
        for model in data.get("models", []):
            name = str(model.get("name", ""))
            if name == OLLAMA_MODEL or name.startswith(OLLAMA_MODEL + ":"):
                return True
    except Exception:
        pass
    return False


def ensure_model() -> bool:
    if model_installed():
        print(f"[OK] Modelo local {OLLAMA_MODEL} instalado.")
        return True
    answer = input(f"O modelo {OLLAMA_MODEL} não está instalado. Baixar agora? [s/N]: ").strip().lower()
    if answer != "s":
        print(f"Instale depois com: ollama pull {OLLAMA_MODEL}")
        return False
    if not run(["ollama", "pull", OLLAMA_MODEL], cwd=ROOT, description=f"Baixando {OLLAMA_MODEL}"):
        return False
    return model_installed()


def check_env() -> bool:
    root_path = ROOT / ".env"
    front_path = FRONTEND / ".env.local"
    if not root_path.exists() or not front_path.exists():
        print("[ERRO] Faltam arquivos de ambiente.")
        print("Escolha primeiro a opção 1 para criar os modelos e depois preencha as credenciais.")
        return False

    root_env = read_env(root_path)
    front_env = read_env(front_path)
    missing = []
    for key in ("GURAI_API_KEY", "OLLAMA_API_KEY"):
        if not root_env.get(key) or "COLOQUE_" in root_env[key] or root_env[key].startswith("VALOR_"):
            missing.append(f".env: {key}")
    for key in ("GURAI_BACKEND_URL", "GURAI_BACKEND_API_KEY", "NEXT_PUBLIC_FIREBASE_PROJECT_ID"):
        if not front_env.get(key) or any(token in front_env[key] for token in ("COLOQUE_", "VALOR_", "SEU_PROJETO", "ID_REAL")):
            missing.append(f"frontend/.env.local: {key}")
    if root_env.get("GURAI_API_KEY") and front_env.get("GURAI_BACKEND_API_KEY") and root_env["GURAI_API_KEY"] != front_env["GURAI_BACKEND_API_KEY"]:
        missing.append("GURAI_API_KEY e GURAI_BACKEND_API_KEY precisam ser iguais")
    if missing:
        print("[ERRO] Revise as seguintes configurações (os valores secretos não são exibidos):")
        for item in missing:
            print(" -", item)
        return False
    print("[OK] Arquivos de ambiente e chaves de comunicação verificados sem exibir os segredos.")
    print("[LEMBRETE] Confira as demais variáveis do Firebase, Google OAuth e e-mail se esses métodos de login forem usados.")
    return True


def new_console(title: str, cwd: Path, command: str) -> None:
    subprocess.Popen(
        ["cmd.exe", "/c", "start", title, "cmd.exe", "/k", command],
        cwd=str(cwd),
    )


def start_all() -> None:
    line()
    print("INICIANDO GURAI")
    line()
    if os.name != "nt":
        print("Este iniciador foi preparado para Windows. Use o README para comandos manuais em outros sistemas.")
        return
    if not check_env():
        print("Corrija as variáveis de ambiente antes de iniciar os serviços.")
        return
    if not start_ollama() or not ensure_model():
        print("Não foi possível validar o serviço de embeddings. Inicialização cancelada.")
        return
    if not (FRONTEND / "node_modules").exists():
        answer = input("node_modules não existe. Executar npm ci agora? [s/N]: ").strip().lower()
        if answer != "s" or not run(["npm", "ci"], cwd=FRONTEND, description="Instalando dependências do frontend"):
            return

    py = python_for_project()
    backend_command = f'"{py}" -m uvicorn api:app --host 127.0.0.1 --port 8000'
    frontend_command = "npm run dev"
    new_console("GurAI FastAPI :8000", ROOT, backend_command)
    time.sleep(2)
    new_console("GurAI Next.js :3000", FRONTEND, frontend_command)
    print("\n[OK] Foram abertas janelas separadas para FastAPI e Next.js.")
    print("Ollama: http://127.0.0.1:11434")
    print("FastAPI: http://127.0.0.1:8000/health")
    print("API docs: http://127.0.0.1:8000/docs")
    print("Frontend: http://localhost:3000")
    print("Mantenha as janelas abertas durante o uso.")


def index_base() -> None:
    print("A indexação sincroniza a coleção persistente do ChromaDB e pode alterar registros.")
    print("Não a execute em cada inicialização; use quando a base documental mudar ou precisar ser criada.")
    answer = input("Deseja continuar e executar indexar_base.py? [s/N]: ").strip().lower()
    if answer != "s":
        print("Indexação cancelada; nenhum dado foi alterado por este iniciador.")
        return
    if not start_ollama() or not ensure_model():
        return
    py = python_for_project()
    run([py, "indexar_base.py"], cwd=ROOT, description="Executando indexação da base documental")


def main() -> None:
    # Permite executar uma ação diretamente pelos arquivos .bat:
    # gerenciar_gurai.py setup | check | index | start
    direct_commands = {
        "setup": setup,
        "check": lambda: (check_tools(), check_env()),
        "index": index_base,
        "start": start_all,
    }
    if len(sys.argv) > 1:
        action = sys.argv[1].strip().lower()
        if action in direct_commands:
            direct_commands[action]()
            return
        print("Ação desconhecida. Use setup, check, index ou start.")
        return

    while True:
        line()
        print("GurAI — GERENCIADOR DE EXECUÇÃO")
        print(f"Projeto detectado: {ROOT}")
        line()
        print("1. Preparar ambiente (Python, npm e modelos de configuração)")
        print("2. Verificar ambiente e variáveis (sem mostrar segredos)")
        print("3. Indexar/sincronizar a base ChromaDB (ação confirmada pelo usuário)")
        print("4. Iniciar Ollama + FastAPI + frontend em janelas separadas")
        print("5. Sair")
        choice = input("Escolha uma opção [1-5]: ").strip()
        if choice == "1":
            setup()
        elif choice == "2":
            check_tools()
            check_env()
            if ollama_healthy():
                print("[OK] Ollama está acessível.")
                print("[OK] nomic-embed-text instalado." if model_installed() else "[FALTA] nomic-embed-text; use 'ollama pull nomic-embed-text'.")
            else:
                print("[FALTA] Ollama não respondeu em", OLLAMA_URL)
        elif choice == "3":
            index_base()
        elif choice == "4":
            start_all()
        elif choice == "5":
            print("Encerrando o gerenciador. As janelas de serviços abertas continuam ativas.")
            break
        else:
            print("Opção inválida; escolha de 1 a 5.")
        input("\nPressione Enter para voltar ao menu...")


if __name__ == "__main__":
    main()

# Copie este arquivo para frontend/.env.local.
# Substitua os exemplos por valores reais da equipe.
# Não compartilhe esse arquivo preenchido nem faça commit dele.

# Comunicação frontend -> FastAPI local
GURAI_BACKEND_URL=http://127.0.0.1:8000
# Deve ser EXATAMENTE igual a GURAI_API_KEY do .env da raiz
GURAI_BACKEND_API_KEY=COLOQUE_A_MESMA_CHAVE_DE_GURAI_API_KEY_AQUI

# Firebase client / projeto
NEXT_PUBLIC_FIREBASE_API_KEY=VALOR_REAL_DO_FIREBASE
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=SEU_PROJETO.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ID_REAL_DO_PROJETO_FIREBASE
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=VALOR_REAL_DO_FIREBASE
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=VALOR_REAL_DO_FIREBASE
NEXT_PUBLIC_FIREBASE_APP_ID=VALOR_REAL_DO_FIREBASE

# NextAuth / Google OAuth
GOOGLE_CLIENT_ID=SEU_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=SEU_GOOGLE_CLIENT_SECRET
NEXTAUTH_SECRET=COLOQUE_UM_SEGREDO_LONGO_E_PRIVADO
NEXTAUTH_URL=http://localhost:3000

# Login por código de acesso via e-mail (se utilizado)
EMAIL_USER=EMAIL_DE_ENVIO
EMAIL_PASS=SENHA_DE_APLICATIVO_DO_EMAIL

# Firebase Admin: use credenciais ADC configuradas na máquina ou, se a equipe
# usa conta de serviço, aponte para um JSON privado guardado FORA do repositório.
# Prefira barras normais no Windows, por exemplo:
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/SEU_USUARIO/segredos/firebase-service-account.json

# Opcional, para mapa Carto conforme a configuração da interface
NEXT_PUBLIC_CARTO_API_KEY=SUA_CHAVE_CARTO_SE_APLICAVEL

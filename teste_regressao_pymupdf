from services.rag.document_loader import load_documents
from services.rag.parsers.manual_parser import parse_manual_toc_page
from services.rag.parsers.modbus_parser import parse_modbus_page

from services.conhecimento_loader import load_all_documents
from services.conhecimento_queries import search_conhecimento_context


DOCUMENT_MANUAL = "GW_HCA-G2_User-Manual-PT.pdf"
DOCUMENT_MODBUS = "Mapa-MODBUS_HCA-G2.pdf"

EXPECTED_DOCUMENTS = {
    "GW_HCA-G2_Datasheet-PT.pdf",
    DOCUMENT_MANUAL,
    DOCUMENT_MODBUS,
}


def validate(condition: bool, message: str) -> None:
    """Interrompe o teste se uma condição não for satisfeita."""
    if not condition:
        raise AssertionError(f"FALHOU: {message}")

    print(f"[OK] {message}")


def main() -> None:
    print("=" * 60)
    print("TESTE INTEGRADO — MIGRAÇÃO PARA PYMuPDF")
    print("=" * 60)

    # 1. Validar o carregador por página.
    documents = load_documents()

    document_names = {
        document["documento"]
        for document in documents
    }

    validate(
        len(documents) == 81,
        f"81 páginas extraídas; total encontrado: {len(documents)}",
    )

    validate(
        document_names == EXPECTED_DOCUMENTS,
        "Os três PDFs esperados foram carregados",
    )

    required_fields = {
        "documento",
        "caminho",
        "pagina",
        "texto",
    }

    validate(
        all(
            required_fields.issubset(document.keys())
            for document in documents
        ),
        "Todas as páginas possuem os quatro campos esperados",
    )

    # 2. Validar o parser do índice do manual.
    manual_page = next(
        (
            document
            for document in documents
            if document["documento"] == DOCUMENT_MANUAL
            and document["pagina"] == 3
        ),
        None,
    )

    validate(
        manual_page is not None,
        "Página 3 do manual encontrada",
    )

    toc_entries = parse_manual_toc_page(manual_page)

    validate(
        len(toc_entries) == 35,
        f"35 entradas do índice reconhecidas; encontradas: "
        f"{len(toc_entries)}",
    )

    # 3. Validar o parser MODBUS.
    modbus_pages = [
        document
        for document in documents
        if document["documento"] == DOCUMENT_MODBUS
    ]

    validate(
        len(modbus_pages) == 9,
        f"9 páginas MODBUS carregadas; encontradas: "
        f"{len(modbus_pages)}",
    )

    modbus_records = []

    for page in modbus_pages:
        parsed_page = parse_modbus_page(page)
        modbus_records.extend(parsed_page.get("registros", []))

    validate(
        len(modbus_records) == 114,
        f"114 registros MODBUS reconhecidos; encontrados: "
        f"{len(modbus_records)}",
    )

    addresses = [
        record["address"]
        for record in modbus_records
    ]

    validate(
        len(addresses) == len(set(addresses)),
        "Nenhum endereço MODBUS duplicado",
    )

    incomplete_records = [
        record
        for record in modbus_records
        if record.get("access") is None
        or record.get("data_type") is None
    ]

    validate(
        len(incomplete_records) == 4,
        "Quatro intervalos reservados permanecem sem "
        "metadados técnicos",
    )

    # 4. Validar o carregador documental legado.
    knowledge = load_all_documents()

    validate(
        isinstance(knowledge, str) and bool(knowledge.strip()),
        f"Base legada carregada: {len(knowledge)} caracteres",
    )

    # 5. Validar a execução da busca legada.
    search_result = search_conhecimento_context(
        "modelo aplicável"
    )

    validate(
        isinstance(search_result, str) and bool(search_result.strip()),
        "A busca legada retornou conteúdo",
    )

    print("\n" + "=" * 60)
    print("TODOS OS TESTES DE REGRESSÃO PASSARAM")
    print("=" * 60)

    print(
        "\nObservação: o teste verifica a execução e a estrutura "
        "dos resultados, não a relevância semântica da busca legada."
    )


if __name__ == "__main__":
    main()